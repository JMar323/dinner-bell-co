# Copy to /etc/dinnerbellco/.env on the VPS (chmod 600, owned by the user that runs the Python commands).
# Never commit real values, and never paste them into chat or an n8n node.
PRINTIFY_TOKEN=
# Optional: only if Printify has more than one Etsy shop. `python3 -m dbc printify-check` lists the ids.
PRINTIFY_SHOP_ID=
ETSY_KEYSTRING=
ETSY_SHARED_SECRET=
ETSY_REFRESH_TOKEN=
ANTHROPIC_API_KEY=
# Where alert emails go. The SMTP/Gmail login itself lives in n8n's credential store, not here.
ALERT_EMAIL_TO=
ALERT_EMAIL_FROM=
# Writable folder where routines remember what they already emailed.
DBC_STATE_DIR=/var/lib/dinnerbellco
