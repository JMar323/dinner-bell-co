{
  "name": "Dinner Bell Co: weekly idea research",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 8 * * 1"
            }
          ]
        }
      },
      "id": "1bb3f9af-44e5-539c-93ee-ecb5ac52beb8",
      "name": "Mondays at 8am",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        0
      ]
    },
    {
      "parameters": {
        "command": "cd ~/dinner-bell-co && python3 -m dbc --json research"
      },
      "id": "c310a64a-ca64-5b07-9630-0ee847f406cc",
      "name": "Run research",
      "type": "n8n-nodes-base.executeCommand",
      "typeVersion": 1,
      "position": [
        220,
        0
      ]
    },
    {
      "parameters": {
        "jsCode": "// research prints one JSON object (see dbc/research.py): the report as an email,\n// an error email, or nothing when this week was already done.\nconst out = JSON.parse($input.first().json.stdout);\nif (!out.email || !out.email.send) return [];\nreturn [{ json: { ...out.email, ok: out.ok, ideas: out.ideas, cost_usd: out.cost_usd } }];"
      },
      "id": "820aa0dc-16a7-5841-95ed-8980f7c2149f",
      "name": "Anything to email?",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        440,
        0
      ]
    },
    {
      "parameters": {
        "fromEmail": "={{ $json.from }}",
        "toEmail": "={{ $json.to }}",
        "subject": "={{ $json.subject }}",
        "emailFormat": "text",
        "text": "={{ $json.text }}",
        "options": {
          "appendAttribution": false
        }
      },
      "id": "2002daeb-d56a-5d5e-b762-a368764f3e20",
      "name": "Email John",
      "type": "n8n-nodes-base.emailSend",
      "typeVersion": 2.1,
      "position": [
        660,
        0
      ]
    }
  ],
  "connections": {
